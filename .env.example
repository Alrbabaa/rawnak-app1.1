# Never commit the real .env.

# --- Firebase (the only data/auth backend — see Firestore, Auth, Storage) ---

# Client config — NOT secret, safe in the browser bundle (from Firebase
# Console > Project Settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web push — from Firebase Console > Project Settings > Cloud Messaging >
# Web configuration > Web Push certificates ("Generate key pair" if none
# exists yet). Without this, push silently no-ops — see
# src/lib/firebase/messaging.ts. Native (iOS/Android) push is separate and
# not yet implemented — see that file's header comment.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Admin SDK — SECRET, server-only (from Firebase Console > Project Settings
# > Service accounts > Generate new private key). Never commit the actual
# JSON file; extract these three fields into env vars instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Exact name of the bucket created in Firebase Storage. This is server-only
# so upload configuration cannot accidentally depend on stale client config.
FIREBASE_STORAGE_BUCKET=

# Comma-separated list of emails that get super_admin automatically on
# sign-in (see src/lib/admin-check.ts). SECRET-ish, server-only — do not
# hardcode admin emails in source. Additional admins can also be granted
# via the Firestore `adminWhitelist` collection or a user doc's `role`
# field, without touching this env var.
ADMIN_EMAILS=

# --- AI provider ---
# The app is provider-agnostic (see src/lib/ai/service.ts). Adding a new
# provider only requires implementing src/lib/ai/provider-<name>.ts and
# adding its env vars here — no business logic changes.

# Which AI provider src/lib/ai/service.ts uses for every AI feature EXCEPT
# image analysis (chat, routines, recommendations, ...). Defaults to
# "gemini" if unset. Options: gemini, openai
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini. Get a key from https://aistudio.google.com
GEMINI_API_KEY=
# Optional — switch models (e.g. gemini-2.5-pro) without any code change.
# Defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=gemini-3.6-flash

# Required for image analysis (see below) and whenever AI_PROVIDER=openai.
# Get a key from https://platform.openai.com/api-keys — server-side only,
# never NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# --- Image analysis pipeline (skin-analysis) ---
# Dedicated two-provider flow, independent of AI_PROVIDER above — see
# src/lib/ai/image-analysis.ts. Image → OpenAI (primary visual analysis) →
# Gemini (independent review) → final result. Only these two providers are
# implemented for this pipeline; other values fail loudly at call time.
IMAGE_ANALYSIS_PROVIDER=openai
IMAGE_ANALYSIS_REVIEWER=gemini

# Set to "false" to skip the Gemini review stage entirely (OpenAI result
# only, marked reviewStatus: "review_unavailable") — cuts image-analysis
# cost roughly in half. Defaults to enabled if unset.
IMAGE_ANALYSIS_REVIEW_ENABLED=true

# Set to "true" to fall back to Gemini alone if OpenAI fails (still marked
# reviewStatus: "review_unavailable" — never a faked two-provider result).
# Defaults to disabled (a failed OpenAI call just returns a clear error).
IMAGE_ANALYSIS_FALLBACK_ENABLED=false

# --- Subscriptions (RevenueCat) ---
# The app is provider-agnostic here too (see src/lib/subscription/service.ts).
# Defaults to "revenuecat" if unset.
SUBSCRIPTION_PROVIDER=revenuecat

# SECRET, server-only. Set the same arbitrary value here and in RevenueCat's
# dashboard (Project Settings > Integrations > Webhooks > Authorization
# header value) — RevenueCat sends it back verbatim on every webhook call,
# and src/app/api/webhooks/revenuecat/route.ts checks for an exact match.
REVENUECAT_WEBHOOK_AUTH_SECRET=

# Public API keys (safe in the browser bundle, per RevenueCat's own docs —
# access control is enforced server-side by the webhook secret above, not
# by hiding these). One per platform, from RevenueCat dashboard > API keys.
NEXT_PUBLIC_REVENUECAT_APPLE_API_KEY=
NEXT_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
